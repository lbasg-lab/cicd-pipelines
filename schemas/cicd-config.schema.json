{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbasg-lab/cicd-pipelines/schemas/cicd-config.schema.json",
  "title": "lbasg-lab CI/CD Configuration",
  "description": "Configuration contract for projects consuming lbasg-lab/cicd-pipelines",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runtime"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the CI/CD configuration contract"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "version"
      ],
      "properties": {
        "stack": {
          "type": "string",
          "enum": [
            "node",
            "terraform"
          ],
          "description": "Runtime stack used by the project"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$",
          "description": "Version of the runtime"
        },
        "package_manager": {
          "type": "string",
          "enum": [
            "npm"
          ],
          "description": "Package manager used by the runtime"
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "description": "Working directory for the stack relative to the repository root"
        }
      },
      "oneOf": [
        {
          "properties": {
            "stack": {
              "const": "node"
            }
          },
          "required": [
            "package_manager"
          ]
        },
        {
          "properties": {
            "stack": {
              "const": "terraform"
            }
          },
          "not": {
            "required": [
              "package_manager"
            ]
          }
        }
      ]
    },
    "terraform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "workspace"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1,
          "description": "HCP Terraform organization"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "description": "HCP Terraform workspace"
        }
      }
    },
    "deployment": {
      "type": "boolean",
      "description": "Whether the deployment stage may apply or deploy changes"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "azure"
          ],
          "description": "Target deployment platform"
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "description": "Azure subscription ID"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "azure"
              }
            }
          },
          "then": {
            "required": [
              "subscription_id"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "stack": {
                "const": "terraform"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "terraform"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "stack": {
                "const": "node"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "terraform"
          ]
        }
      }
    }
  ]
}